#####################################
#       CONFIGURATION ALBERT        #
#####################################
# Clé d'API Albert (obligatoire)
ALBERT_API_KEY=
# Modèle de génération de la réponse (obligatoire)
ALBERT_MODELE=
# Délai maximal en secondes pour la réponse à une question (15 si absent)
ALBERT_DELAI_REPONSE_MAXIMUM_REPONSE_QUESTION=15
# Délai maximal en secondes pour la recherche de paragraphes (3 si absent)
ALBERT_DELAI_REPONSE_MAXIMUM_RECHERCHE_PARAGRAPHES=3
# true pour la recherche hybride, false pour la recherche sémantique
ALBERT_UTILISE_RECHERCHE_HYBRIDE=false
# Modèle de reclassement BGE (openweight-rerank si absent)
MODELE_RECLASSEMENT=openweight-rerank
# Décalage entre l'index Albert et le numéro de page affiché (0 si absent)
DECALAGE_INDEX_ALBERT_ET_NUMERO_DE_PAGE_LECTEUR=0
# Nombre d'échanges de l'historique envoyés au modèle (10 si absent)
ALBERT_TAILLE_FENETRE_HISTORIQUE=2
# Modèle de reformulation de la question (obligatoire)
ALBERT_MODELE_REFORMULATION=
# Nombre de paragraphes retenus après reclassement (10 si absent, ne pas laisser vide)
NOMBRE_PARAGRAPHES=10
# Mode de reclassement : bge (défaut), llm, ou llm_parallele (classification structurée, lots traités en parallèle)
TYPE_RECLASSEUR=bge
# Taille des lots du reclassement llm_parallele (5 si absent)
ALBERT_RECLASSEMENT_TAILLE_LOT=5
# Nom de la collection Albert des guides ANSSI (ANSSI_test si absent)
# COLLECTION_NOM_ANSSI_LAB=ANSSI_test
# true pour activer la recherche Jeopardy (false si absent)
# JEOPARDY_ACTIVE=false
# Collection Albert de la recherche Jeopardy (4243 si absente)
# COLLECTION_ID_ANSSI_LAB_JEOPARDY=4243
# Seuil de score à partir duquel une réponse maîtrisée (FAQ) est retenue (0.8 si absent)
# SEUIL_REPONSE_MAITRISEE=0.8

#####################################
#    CONFIGURATION CONVERSATION     #
#####################################
# Identifiant de la collection Albert des guides ANSSI (obligatoire)
COLLECTION_ID_ANSSI_LAB=
# URL du service MesServicesCyber qui fournit les métadonnées des guides (https://messervices.cyber.gouv.fr si absente)
# URL_MSC=https://messervices.cyber.gouv.fr

#####################################
#       CHIFFREMENT                 #
#####################################
# Sel de hachage des identifiants de conversation et d'interaction (obligatoire)
CHIFFREMENT_SEL_DE_HACHAGE=
# Clé de chiffrement des contenus de conversation (obligatoire hors modes TEST et DEVELOPPEMENT)
CHIFFREMENT_CLEF_DE_CHIFFREMENT=

#####################################
#       SERVEUR                     #
#####################################
# Adresse d'écoute, par exemple 127.0.0.1 sur l'hôte (obligatoire)
HOST=
# Port d'écoute, par exemple 8000 sur l'hôte et 3001 avec Docker Compose (obligatoire)
PORT=
# Nombre maximal de requêtes par minute et par adresse IP (600 si absent)
SERVEUR_MAX_REQUETES_PAR_MINUTE=600

#####################################
#       BASE DE DONNÉES             #
#####################################
# Hôte PostgreSQL : localhost sur l'hôte, mqc-db avec Docker Compose (obligatoire)
DB_HOST=
# Port PostgreSQL (obligatoire)
DB_PORT=
# Nom de la base : identique à POSTGRES_DB de docker-compose.yml avec Docker Compose (obligatoire)
DB_NAME=
# Utilisateur PostgreSQL : postgres avec Docker Compose (obligatoire)
DB_USER=
# Mot de passe PostgreSQL : identique à POSTGRES_PASSWORD de docker-compose.yml avec Docker Compose (obligatoire)
DB_PASSWORD=

#####################################
#       JOURNAL                     #
#####################################
# Journal d'événements (optionnel) : utilisé seulement en mode PRODUCTION quand DB_JOURNAL_HOST est renseigné
# Valeurs par défaut si absentes : localhost, 5432, postgres, postgres, journal
DB_JOURNAL_HOST=
DB_JOURNAL_PORT=
DB_JOURNAL_USER=
DB_JOURNAL_PASSWORD=
DB_JOURNAL_NAME=

#####################################
#               SENTRY              #
#####################################
# DSN Sentry (optionnel)
SENTRY_DSN=
# Environnement transmis à Sentry (developpement si absent)
SENTRY_ENVIRONNEMENT=
# memoire (défaut) ou standard pour transmettre les erreurs à Sentry
SENTRY_TYPE_ADAPTATEUR=memoire

#####################################
#       FEATURE FLAGS               #
#####################################
# true pour le mode alpha test : consigne dans le journal les questions des utilisateurs et les sources retournées
ALPHA_TEST=false
# Mode de l'application : production, developpement ou test (obligatoire, ne pas laisser vide)
MODE=
# true pour afficher la page de maintenance
MODE_MAINTENANCE=false
